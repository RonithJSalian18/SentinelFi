# PostgreSQL Connection String (e.g. Supabase, Neon, or local PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/sentinelfi

# Google Gemini API Key (from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Redis broker for the Celery task queue + WebSocket notifications.
# Leave unset for local dev: jobs then run in-process via FastAPI BackgroundTasks.
# REDIS_URL=redis://localhost:6379/0

# Maximum accepted PDF upload size in megabytes
MAX_UPLOAD_MB=25

# Force the pure-Python AML engine even if the C++ extension is built (cpp | python)
# AML_ENGINE=python
