# PostgreSQL Connection String (e.g. Supabase, Neon, or local PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/sentinelfi

# Google Gemini API Key (from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Redis broker for the Celery task queue + WebSocket notifications.
# Leave unset for local dev: jobs then run in-process via FastAPI BackgroundTasks.
# REDIS_URL=redis://localhost:6379/0

# Maximum accepted PDF upload size in megabytes
MAX_UPLOAD_MB=25

# Force the pure-Python AML engine even if the C++ extension is built (cpp | python)
# AML_ENGINE=python

# Allowed frontend origins (comma-separated) for CORS and the embedded PDF viewer
CORS_ORIGINS=http://localhost:3000

# --- Document storage (KYC audit retention) ---
# Leave S3_BUCKET unset to archive PDFs on local disk (development only).
# S3_BUCKET=sentinelfi-kyc-documents
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# Optional: use SSE-KMS instead of SSE-S3 (AES256) encryption at rest
# S3_KMS_KEY_ID=arn:aws:kms:us-east-1:123456789012:key/...
# Optional: S3-compatible endpoint (MinIO, Cloudflare R2, LocalStack)
# S3_ENDPOINT_URL=http://localhost:9000
# Optional: browser-facing endpoint for pre-signed URLs, if it differs from S3_ENDPOINT_URL
# S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
# Lifetime of pre-signed document URLs, in seconds
S3_PRESIGNED_URL_TTL=900

# Local storage fallback settings
# LOCAL_STORAGE_DIR=./storage
# Set a fixed key so signed local document links survive restarts
# LOCAL_STORAGE_SIGNING_KEY=change-me

# --- Authentication (JWT / OAuth2) ---
# Signing key for access tokens. REQUIRED in production; generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Lock an account (per client IP) after this many failed logins, for this many seconds
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900
# Optional: create the first System Admin on startup if no admin exists yet
# BOOTSTRAP_ADMIN_EMAIL=admin@yourbank.com
# BOOTSTRAP_ADMIN_PASSWORD=change-me-to-something-long
# BOOTSTRAP_ADMIN_NAME=System Admin
