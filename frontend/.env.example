# Auth.js session encryption secret. Generate one with:  npx auth secret
#   (or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
AUTH_SECRET=

# Public URL of the FastAPI backend (baked into the browser bundle at build time)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Optional: address the Next.js server uses to reach the API for sign-in, if different
# (e.g. a private network hostname). Defaults to NEXT_PUBLIC_API_URL.
# API_INTERNAL_URL=http://api:8000

# Required when self-hosting behind a proxy (not needed on Vercel or in `npm run dev`)
# AUTH_TRUST_HOST=true
